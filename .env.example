# --- URLs ---
NEXTAUTH_URL=

# --- Comment email notifications (optional; all three are required to send) ---
RESEND_API_KEY=
COMMENT_NOTIFICATION_TO=
COMMENT_NOTIFICATION_FROM=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=

# --- Database (choose ONE per env, see below) ---
DATABASE_URL=

# --- Feature flags ---
NEXT_PUBLIC_FEATURE_BREADCRUMBS_V1=true

# --- Analytics archive (server-only; collection off by default) ---
ANALYTICS_VERCEL_TOKEN=
ANALYTICS_PROJECT_ID=
ANALYTICS_TEAM_ID=
# Collection remains off unless this value is exactly true.
ANALYTICS_SYNC_ENABLED=false
# Operator-confirmed earliest fully retained day, YYYY-MM-DD (UTC); no default.
ANALYTICS_AVAILABLE_FROM=
# Vercel cron bearer secret; use a random value of at least 16 characters.
CRON_SECRET=
