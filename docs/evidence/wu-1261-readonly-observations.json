      "constraints": [
        {
          "name": "homie_drafted_check",
          "table": "dojo.homie",
          "definition": "CHECK (((drafted >= 0) AND (drafted <= 65535)))"
        },
        {
          "name": "homie_pkey",
          "table": "dojo.homie",
          "definition": "PRIMARY KEY (id)"
        },
        {
          "name": "tags_pkey",
          "table": "dojo.tags",
          "definition": "PRIMARY KEY (id)"
        },
        {
          "name": "tags_slug_key",
          "table": "dojo.tags",
          "definition": "UNIQUE (slug)"
        },
        {
          "name": "homie_tag_slug_key",
          "table": "dojo.homie",
          "definition": "UNIQUE (tag_slug)"
        },
        {
          "name": "homie_tag_slug_check",
          "table": "dojo.homie",
          "definition": "CHECK (((tag_slug IS NULL) OR ((tag_slug)::text ~ '^[a-z0-9]+(?:-[a-z0-9]+)*$'::text)))"
        },
        {
          "name": "tags_href_check",
          "table": "dojo.tags",
          "definition": "CHECK (((href IS NULL) OR (btrim(href) <> ''::text)))"
        },
        {
          "name": "tags_display_name_check",
          "table": "dojo.tags",
          "definition": "CHECK (((display_name IS NULL) OR (btrim(display_name) <> ''::text)))"
        },
        {
          "name": "tags_meta_object_check",
          "table": "dojo.tags",
          "definition": "CHECK ((jsonb_typeof(meta) = 'object'::text))"
        },
        {
          "name": "tags_href_kind_check",
          "table": "dojo.tags",
          "definition": "CHECK ((href_kind = ANY (ARRAY['tag'::text, 'persona'::text, 'squad'::text, 'homie'::text, 'clan'::text, 'custom'::text, 'external'::text, 'none'::text])))"
        },
        {
          "name": "schema_migration_status_check",
          "table": "dojo.schema_migration",
          "definition": "CHECK ((status = ANY (ARRAY['applied'::text, 'failed'::text])))"
        },
        {
          "name": "schema_migration_applied_at_check",
          "table": "dojo.schema_migration",
          "definition": "CHECK (((status = 'failed'::text) OR (applied_at IS NOT NULL)))"
        },
        {
          "name": "schema_migration_pkey",
          "table": "dojo.schema_migration",
          "definition": "PRIMARY KEY (filename)"
        }
      ]
    }
